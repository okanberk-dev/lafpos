{"message":"OK","data":{"content":"<h2>Active/Inactive and Status of Products</h2><p><span style=\"background-color:transparent;color:rgb(66,66,66);\"><strong>GET - /products/{productId}/status</strong></span></p><p><span style=\"background-color:transparent;color:rgb(66,66,66);\"><strong>GET - /products/chain-id/{chainProductId}/status</strong></span></p><p><span style=\"background-color:transparent;color:rgb(66,66,66);\">You can query the status of your products in the menu with these endpoints.</span></p><figure class=\"table\" style=\"float:left;width:200px;\"><table><thead><tr><th style=\"vertical-align:top;\"><p style=\"text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Definition</strong></span></p></th><th style=\"vertical-align:top;\"><p style=\"text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Type</strong></span></p></th></tr></thead><tbody><tr><td style=\"text-align:center;\"><p style=\"text-align:center;\">Active</p></td><td style=\"text-align:center;\"><p style=\"text-align:center;\"><span style=\"background-color:transparent;color:rgb(66,66,66);\">100</span></p></td></tr><tr><td style=\"text-align:center;\"><p style=\"text-align:center;\">Inactive</p></td><td style=\"text-align:center;\"><p style=\"text-align:center;\"><span style=\"background-color:transparent;color:rgb(66,66,66);\">200</span></p></td></tr></tbody></table></figure><p>&nbsp;</p><p><span style=\"background-color:transparent;color:rgb(66,66,66);\"><strong>PUT - /products/{productId}/status&nbsp;</strong></span></p><p><span style=\"background-color:transparent;color:rgb(66,66,66);\"><strong>PUT - /products/chain-id/{chainProductId}/status&nbsp;</strong></span></p><p><span style=\"background-color:transparent;color:rgb(66,66,66);\">You can update these products active or inactive with these endpoints.</span></p><figure class=\"image image_resized\" style=\"width:100%;\"><img src=\"/uploads/product_1.png\"></figure><p>&nbsp;</p>"}}