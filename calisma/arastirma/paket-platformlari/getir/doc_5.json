restaurants​/zones​/{zoneId}</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/restaurants​/courier​/disable</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/restaurants​/courier​/enable</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/restaurants​/payment-methods​/active</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/restaurants​/payment-methods​/inactive</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/average-preparation-time</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/delivery-duration</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">DELETE</td><td>​/restaurants​/delivery-duration</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/status​/close</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/status​/open</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/zones​/{zoneId}​/inactive</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/zones​/{zoneId}​/active</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/option-products​/{optionProductId}​/option-categories​/{optionCategoryId}​/options​/{optionId}​/status</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/restaurants​/option-products​/chain-id​/{chainOptionProductId}​/option-categories​/{chainOptionCategoryId}​/options​/{chainOptionId}​/status</td><td style=\"text-align:center;\">TRUE</td><td>2 req, 60s, 30s block</td></tr></tbody></table></figure><p>&nbsp;</p>"}}