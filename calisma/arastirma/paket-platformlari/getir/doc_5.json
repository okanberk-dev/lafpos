{"message":"OK","data":{"content":"<h2><span style=\"background-color:transparent;color:#5c3ebc;\"><strong>Rate Limiter</strong></span></h2><p><span style=\"background-color:transparent;color:#424242;\">Rate limiter is used to prevent regular requests to our endpoints(except&nbsp;/periodic endpoints) for short periods.</span></p><p><span style=\"background-color:transparent;color:#000000;\">Default Values: If 300+ requests are received within 60 seconds with the same token, the token will be blocked for 20 seconds.</span></p><figure class=\"table\" style=\"float:left;width:350px;\"><table><thead><tr><th style=\"background-color:#5D3EBC;height:16.0pt;width:65pt;\"><span style=\"color:#FFD10D;\"><strong>Request</strong></span></th><th style=\"background-color:#5D3EBC;width:65pt;\"><span style=\"color:#FFD10D;\"><strong>Frequency</strong></span></th><th style=\"background-color:#5D3EBC;text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Block&nbsp;</strong></span></th></tr></thead><tbody><tr><td style=\"height:16.0pt;text-align:center;\">300</td><td style=\"text-align:center;\">60 seconds</td><td style=\"text-align:center;\">20 seconds</td></tr></tbody></table></figure><p><strong>Rate Limiter Values for Endpoints</strong></p><figure class=\"table\" style=\"float:left;width:590px;\"><table><thead><tr><th style=\"background-color:#5D3EBC;\"><p style=\"text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Method</strong></span></p></th><th style=\"background-color:#5D3EBC;\"><p style=\"text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Path</strong></span></p></th><th style=\"background-color:#5D3EBC;\"><p style=\"text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Limit</strong></span></p></th><th style=\"background-color:#5D3EBC;\"><p style=\"text-align:center;\"><span style=\"color:#FFD10D;\"><strong>Value</strong></span></p></th></tr></thead><tbody><tr><td style=\"height:16.0pt;\">POST</td><td>/auth/login</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>/food-orders/report</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>/food-orders/report/details</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/report/details</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>/food-orders/{foodOrderId}/available-restaurants-for-transfer</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>/food-orders/{foodOrderId}/cancel-options&nbsp;</td><td style=\"text-align:center;\">TRUE</td><td>40 req, 600s, 60s block</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/food-orders​/active</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/periodic/cancelled&nbsp;</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/periodic/unapproved</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/{foodOrderId}/verify-scheduled</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders​/{foodOrderId}​/deliver</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/{foodOrderId}/prepare</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/{foodOrderId}/transfer-to-another-restaurant</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/{foodOrderId}/handover</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/food-orders​/{foodOrderId}​/cancel</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/food-orders/{foodOrderId}/verify</td><td style=\"text-align:center;\">FALSE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>/payment-methods</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>​/products​/{productId}​/status</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>​/products​/{productId}​/status</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">GET</td><td>/products​/chain-id​/{chainProductId}​/status</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">PUT</td><td>/products​/chain-id​/{chainProductId}​/status</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/products​/{productId}​/inactivate-as-option</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/products​/{productId}​/activate-as-option</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/products​/chain-id​/{chainProductId}​/activate-as-option</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/products​/chain-id​/{chainProductId}​/inactivate-as-option</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>/products​/option-products​/{optionProductId}​/activate-as-option</td><td style=\"text-align:center;\">TRUE</td><td>DEFAULT</td></tr><tr><td style=\"height:16.0pt;\">POST</td><td>​/products​/option-products​/{optionProductId}​/inactivate-as-option</