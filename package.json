{
  "name": "lafpos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "L'Affogato POS: masa, adisyon, mutfak ekranı, kasa, stok, cari ve patron paneli; laffogato ve lafmaliyet ile bağlantılı",
  "engines": {
    "node": ">=22.11 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "start": "tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx server/db/seed.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "kurulum:windows": "node scripts/kasa/windows/kurulum/derle.mjs",
    "kanal": "node scripts/kasa/windows/kurulum/kanal.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.104.5",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tsx": "^4.23.15",
    "uqr": "^0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@noble/hashes": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1",
    "sql.js": "^1.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "web-push": "^3.6.7"
  }
}
