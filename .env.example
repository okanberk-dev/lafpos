# LafPOS ortam değişkenleri. Bu dosyayı .env olarak kopyalayın; hepsi isteğe bağlıdır.

# Sunucu
LAFPOS_PORT=4000
# LAFPOS_HOST=0.0.0.0
# LAFPOS_DATA_DIR=data
# LAFPOS_SESSION_HOURS=14
# PIN özetleri için anahtar. Boşsa data/secret.key'de üretilir ve orada kalır.
# LAFPOS_SECRET=

# laffogato (site). Herkese açık menü anahtarsız çalışır.
LAFFOGATO_URL=https://laffogato.net
# İmzalı panel uçları (Tükendi yazma, online siparişler). Bugün sitenin KARAOKE_SYNC_SECRET değeri, en az 32 karakter.
LAFFOGATO_PANEL_SECRET=

# lafmaliyet (maliyet paneli). Günlük satış/Z itme ucu lafmaliyet'te yazılınca doldurun.
LAFMALIYET_URL=https://ladmin.laffogato.net
LAFMALIYET_POS_SECRET=
