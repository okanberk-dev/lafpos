# LafPOS ortam değişkenleri. Bu dosyayı .env olarak kopyalayın; hepsi isteğe bağlıdır.

# Sunucu
LAFPOS_PORT=4000
# LAFPOS_HOST=0.0.0.0
# LAFPOS_DATA_DIR=data
# LAFPOS_SESSION_HOURS=14
# PIN özetleri için anahtar. Boşsa data/secret.key'de üretilir ve orada kalır.
# LAFPOS_SECRET=

# laffogato (site). Varsayılan kapalı: adres yazılmadıkça LafPOS siteye hiç bağlanmaz (menü, ürün görselleri,
# online siparişler, Tükendi). Açmak için docs/03-ENTEGRASYON.md'deki açılış adımları; herkese açık menü anahtarsız çalışır.
# LAFFOGATO_URL=https://laffogato.net
# İmzalı uçlar (Tükendi yazma, online siparişler): sitedeki LAFPOS_SYNC_SECRET ile aynı değer, en az 32 karakter.
LAFFOGATO_SYNC_SECRET=

# lafmaliyet (maliyet paneli): paneldeki LAFPOS_SYNC_SECRET ile aynı değer.
LAFMALIYET_URL=https://ladmin.laffogato.net
LAFMALIYET_SYNC_SECRET=

# Yazarkasa POS (Token ÖKC, TokenX Connect Cloud). Ayrıntı: docs/04-YAZARKASA.md
# Değerleri Token verir; yalnız kasa bilgisayarındaki .env'de durur.
# TOKENX_AUTH_URL=
# TOKENX_BASKET_URL=
# TOKENX_SETTINGS_URL=
# TOKENX_CLIENT_ID=
# TOKENX_CLIENT_SECRET=
# Anlık sepet için cihaz, liste sepet için şube
# TOKENX_TERMINAL_ID=
# TOKENX_BRANCH_ID=
# TOKENX_APP_RESOURCE=
# Sonuç bildirimi (webhook): LafPOS'un internetten erişilen adresi ve en az 16 karakterlik anahtar.
# Boşsa LafPOS sonucu kendisi sorar.
# LAFPOS_PUBLIC_URL=
# TOKENX_WEBHOOK_SECRET=

# Yemeksepeti (Delivery Hero POS middleware): siparişler internetten LafPOS Uzaktan'a (Vercel) gelir, kasa oradan çeker;
# LAFPOS_CLOUD_URL ve LAFPOS_CLOUD_SECRET de tanımlı olmalı. Delivery Hero'nun verdiği middleware adresi, kullanıcı adı,
# parola ve restoranın POS kimliği (remoteId); Vercel'de YEMEKSEPETI_PLUGIN_SECRET (JWT anahtarı). docs/PAKET-PLATFORMLARI.md
# YEMEKSEPETI_MW_URL=
# YEMEKSEPETI_USERNAME=
# YEMEKSEPETI_PASSWORD=
# YEMEKSEPETI_REMOTE_ID=

# Getir Yemek (GetirFood API): Getir'in POS firmasına verdiği uygulama anahtarı ve restoran anahtarı. Siparişler
# internetten LafPOS Uzaktan'a (Vercel) gelir, kasa oradan çeker (LAFPOS_CLOUD_URL ve LAFPOS_CLOUD_SECRET de tanımlı
# olmalı); yedek olarak kasa Getir'in onaysız sipariş listesini de okur. docs/PAKET-PLATFORMLARI.md
# GETIR_APP_SECRET_KEY=
# GETIR_RESTAURANT_SECRET_KEY=
# Test ortamı https://food-external-api-gateway.development.getirapi.com; boşsa canlı https://food-external-api-gateway.getirapi.com
# GETIR_API_URL=
# Vercel'de (kasada gerekmez): GETIR_WEBHOOK_SECRET, bizim ürettiğimiz en az 16 karakterlik anahtar; Getir'e sipariş ve
# iptal adresleriyle birlikte x-api-key olarak verilir. Ayrı ve rastgele üretilir (ör. openssl rand -hex 24):
# LAFPOS_CLOUD_SECRET'e ya da YEMEKSEPETI_PLUGIN_SECRET'e eşitse aktarıcı kurulmamış sayılır. İsteğe bağlı
# GETIR_RESTAURANT_ID (yalnız bu restoranın siparişi).

# Trendyol Go Yemek (Uber Eats Türkiye siparişleri de buradan): satıcı panelinden satıcı no, API anahtarı ve gizli
# anahtar. Üçü de yazılınca Yönetim › Paket platformları'nda Trendyol Go "Canlı" seçilebilir. docs/PAKET-PLATFORMLARI.md
# TRENDYOL_SUPPLIER_ID=
# TRENDYOL_API_KEY=
# TRENDYOL_API_SECRET=
# Test ortamı için Trendyol'un verdiği adres; boşsa canlı https://api.tgoapps.com
# TRENDYOL_API_URL=
# User-Agent'taki entegratör adı (boşsa LafPOS)
# TRENDYOL_AGENT_NAME=

# LafPOS Uzaktan (Vercel): canlı özetin gittiği adres ve Vercel'deki LAFPOS_CLOUD_SECRET ile aynı anahtar
# (en az 32 karakter). Boşsa buluta hiçbir şey gitmez. Ayrıntı: docs/07-UZAKTAN-ERISIM.md
# LAFPOS_CLOUD_URL=https://lafpos.vercel.app
# LAFPOS_CLOUD_SECRET=
