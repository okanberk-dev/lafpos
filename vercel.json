{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_ASILPOS_UZAKTAN=1 npm run build && npm run build:demo && npm run kanal",
  "outputDirectory": "dist/web",
  "installCommand": "npm ci",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/:yol*",
      "destination": "/api/uzaktan?yol=:yol*"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/((?!assets/).*)",
      "destination": "/demo/index.html"
    },
    {
      "source": "/((?!api/|assets/|guncelleme/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/guncelleme/surum.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/guncelleme/AsilPOS-Kur.cmd",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "content-type",
          "value": "application/octet-stream"
        },
        {
          "key": "content-disposition",
          "value": "attachment; filename=\"AsilPOS-Kur.cmd\""
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/guncelleme/LafPOS-Kur.cmd",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "content-type",
          "value": "application/octet-stream"
        },
        {
          "key": "content-disposition",
          "value": "attachment; filename=\"LafPOS-Kur.cmd\""
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/guncelleme/(.*)\\.zip",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "service-worker-allowed",
          "value": "/"
        }
      ]
    }
  ],
  "functions": {
    "api/uzaktan.ts": {
      "includeFiles": "api/demo-ozet.json"
    }
  },
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  }
}
