{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_LAFPOS_UZAKTAN=1 npm run build && npm run build:demo",
  "outputDirectory": "dist/web",
  "installCommand": "npm ci",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/:yol*",
      "destination": "/api/uzaktan?yol=:yol*"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/((?!assets/).*)",
      "destination": "/demo/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demo/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/uzaktan.ts": {
      "includeFiles": "api/demo-ozet.json"
    }
  },
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  }
}
